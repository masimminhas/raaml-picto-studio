digraph STPA_ControlStructure {
  rankdir=TB;
  splines=polyline;
  nodesep=0.45;
  ranksep=0.90;
  bgcolor="white";
  pad=0.15;
  size="11.0,7.8";
  graph [fontname="Helvetica" fontsize=8 labelloc=t labeljust=l];
  node  [fontname="Helvetica" fontsize=7];
  edge  [fontname="Helvetica" fontsize=6.5];
  subgraph "cluster_CS_001" {
    label="AEB Control Structure\n7 UCAs, 1 control action covered, 6 with no controlAction reference";
    style=filled;
    fillcolor="#f7f9fc";
    color="#1a237e";
    penwidth=1.4;
    fontcolor="#1a237e";
    fontname="Helvetica-Bold";
    { rank=same;
      "CTRL_001" [label="AEB ECU (Controller)" shape=box style="filled,rounded" fillcolor="#e3f2fd" color="#1565c0" penwidth=1.6 fontcolor="#1565c0" fontname="Helvetica-Bold" fontsize=7 width=1.9];
    }
    { rank=same;
      "CP_001" [label="Hydraulic Brake Actuator (Controlled Process)" shape=box style="filled,rounded" fillcolor="#fff3e0" color="#e65100" penwidth=1.6 fontcolor="#e65100" fontname="Helvetica-Bold" fontsize=7 width=1.9];
    }
  }
  "CTRL_001" -> "CP_001" [label="CA-01: Apply Emergency Brake\n[command]\n1 UCA" color="#b71c1c" fontcolor="#b71c1c" penwidth=1.8 arrowhead=normal arrowsize=0.7];
  "CTRL_001" -> "CP_001" [label="CA-02: Release Brake Command\n[command]" color="#90a4ae" fontcolor="#78909c" penwidth=1.0 arrowhead=normal arrowsize=0.7];
  "CTRL_001" -> "CP_001" [label="CA-03: Issue Driver Warning\n[warning]" color="#90a4ae" fontcolor="#78909c" penwidth=1.0 arrowhead=normal arrowsize=0.7];
  "CP_001" -> "CTRL_001" [label="FB-01: Brake Pressure Feedback\n[sensor]" style=dashed color="#00695c" fontcolor="#00695c" penwidth=1.0 arrowsize=0.7 constraint=false];
}
